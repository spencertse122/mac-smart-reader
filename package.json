{
  "name": "smart-reader",
  "productName": "Smart Reader",
  "version": "0.1.0",
  "private": true,
  "description": "Local ebook reader for durable learning",
  "author": "spencertse122",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "postinstall": "electron-builder install-app-deps",
    "fixtures:pdf": "node scripts/make-fixture-pdf.mjs tests/fixtures/books/sample.pdf"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "node-pty": "1.1.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "jsdom": "30.1.3",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}